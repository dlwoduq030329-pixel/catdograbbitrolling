  m_Script: {fileID: 11500000, guid: ac3f2839ba44ce340932437def144ee7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  CODE_EXPLAIN: 0
  charactorText:
  - "\uB0E5\uB8E8\uB294 \uB0E5\uC871 \uCD5C\uACE0\uC758 \uC554\uC0B4\uC790\uC785\uB2C8\uB2E4.
    \uC5B4\uB460 \uC18D\uC5D0 \uBAB8\uC744 \uC228\uAE34 \uCC44 \uC801\uC758 \uBE48\uD2C8\uC744
    \uB178\uB9AC\uBA70, \uB2E8 \uD55C \uBC88\uC758 \uCE58\uBA85\uC801\uC778 \uC77C\uACA9\uC73C\uB85C
    \uC2B9\uBD80\uB97C \uB05D\uB0C5\uB2C8\uB2E4. \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0BC
    \uB54C\uB294 \uC774\uBBF8 \uC804\uD22C\uAC00 \uB05D\uB09C \uB4A4\uB77C\uB294
    \uB9D0\uC774 \uC804\uC124\uCC98\uB7FC \uC804\uD574\uC9D1\uB2C8\uB2E4."
  - "\uBA4D\uB3CC\uC774\uB294 \uB315\uB315\uC871\uC758 \uC6A9\uB9F9\uD55C \uC804\uC0AC\uC785\uB2C8\uB2E4.
    \uB192\uC740 \uCCB4\uB825\uC73C\uB85C \uC804\uC120\uC5D0 \uC11C\uB294 \uAC83\uC744
    \uB450\uB824\uC6CC\uD558\uC9C0 \uC54A\uC73C\uBA70, \uC5B8\uC81C\uB098 \uB3D9\uB8CC\uB4E4\uC744
    \uAC00\uC7A5 \uBA3C\uC800 \uC9C0\uCF1C\uB0C5\uB2C8\uB2E4. \uADF8\uC758 \uAD73\uAC74\uD55C
    \uC758\uC9C0\uB294 \uC5B4\uB5A4 \uC801\uB3C4 \uC27D\uAC8C \uBB34\uB108\uB728\uB9AC\uC9C0
    \uBABB\uD569\uB2C8\uB2E4."
  - "\uD1A0\uD53C\uB294 \uD1A0\uB07C\uC871\uC758 \uCC9C\uC7AC \uB9C8\uBC95\uC0AC\uC785\uB2C8\uB2E4.
    \uAC15\uB825\uD55C \uC6D0\uC18C \uB9C8\uBC95\uC744 \uC790\uC720\uC790\uC7AC\uB85C
    \uB2E4\uB8E8\uBA70, \uC704\uD5D8\uD55C \uC0C1\uD669\uC5D0\uC11C\uB3C4 \uCE68\uCC29\uD558\uAC8C
    \uC804\uC7A5\uC744 \uC9C0\uBC30\uD569\uB2C8\uB2E4. \uC791\uC740 \uCCB4\uAD6C\uC640\uB294
    \uB2EC\uB9AC \uD55C \uBC88\uC758 \uC8FC\uBB38\uC73C\uB85C \uC804\uC138\uB97C
    \uB4A4\uC9D1\uB294 \uD798\uC744 \uC9C0\uB2C8\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
